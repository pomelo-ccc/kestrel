	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#8C8A84",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant.other.placeholder",
				"constant.character"
			],
			"settings": {
				"foreground": "#986801"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language",
				"entity"
			],
			"settings": {
				"foreground": "#0184BC"
			}
		},
		{
			"scope": [
				"entity.name",
				"meta.export.default",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#C18401"
			}
		},
		{
			"scope": [
				"variable.parameter.function",
				"meta.jsx.children",
				"meta.block",
				"meta.tag.attributes",
				"entity.name.constant",
				"meta.object.member",
				"meta.embedded.expression"
			],
			"settings": {
				"foreground": "#2B2A28"
			}
		},
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#4078F2"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#E45649"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#A626A4"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#A626A4"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#2B2A28"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#50A14F"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#0184BC"
			}
		},
		{
			"scope": "meta.property-name",
			"settings": {
				"foreground": "#4078F2"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "#E45649"
			}
		},
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#2B2A28"
			}
		},
		{
			"scope": [
				"invalid.broken",
				"invalid.deprecated",
				"invalid.illegal",
				"invalid.unimplemented"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#DF4B44"
			}
		},
		{
			"scope": "message.error",
			"settings": {
				"foreground": "#DF4B44"
			}
		},
		{
			"scope": "string variable",
			"settings": {
				"foreground": "#0184BC"
			}
		},
		{
			"scope": [
				"source.regexp",
				"string.regexp"
			],
			"settings": {
				"foreground": "#50A14F"
			}
		},
		{
			"scope": "support.type.property-name.json",
			"settings": {
				"foreground": "#E45649"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#181817"
			}
