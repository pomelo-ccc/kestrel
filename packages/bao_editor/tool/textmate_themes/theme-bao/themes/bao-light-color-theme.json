				"support.class.component"
			],
			"settings": {
				"foreground": "#3D7A47"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#9A6421"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#9A6421"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#292927"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#5E7A26"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": "meta.property-name",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "#2F7A6C"
			}
		},
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#292927"
			}
		},
