			],
			"settings": {
				"foreground": "#9AB0CC"
			}
		},
		{
			"scope": [
				"entity.name",
				"meta.export.default",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#8FC1B5"
			}
		},
		{
			"scope": [
